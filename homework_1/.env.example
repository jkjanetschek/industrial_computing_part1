# Copy to .env and fill in.  Loaded by server.py and client.py via python-dotenv.

# smoke test does not start server after test
MCP_SMOKE_TEST=false

#  MCP server / transport -> http | stdio
MCP_TRANSPORT=stdio
MCP_SERVER_URL=http://localhost:8000/mcp

# log file locations
INVENTORY_DB=inventory.db
AUDIT_LOG=audit.log
AGENT_LOG=agent.log



###### LLM config

# proxy (litellm docker) | direct (litellm lib)
LLM_MODE=proxy

# direct mode
# LiteLLM native Google AI Studio provider (not Vertex AI).
# The "gemini/" prefix is required for the /openai endpoint
MODEL_NAME_GEMINI=
GEMINI_API_KEY=
GEMINI_API_BASE=

MODEL_NAME_OPENAI=
OPENAI_API_KEY=

# proxy mode
LITELLM_API_BASE=http://localhost:4000
LITELLM_KEY=
MODEL_NAME_PROXY=

DEMO_MODE=false
DEMO_PROMPT=

###### Web UI (client.py)

# set to enable the browser UI instead of the CLI/demo prompt
WEB_MODE=false
WEB_PORT=8080

