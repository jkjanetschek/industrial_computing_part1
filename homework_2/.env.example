# Copy to .env and fill in. Never commit real secrets here.
# Loaded once by shared/settings.py (pydantic-settings) from .env, so every
# process (registry, agents, coordinator) sees the same values. Real environment variables
# beat this file, which is how docker-compose.yml overrides the container-side addresses.
# Values shown below are the built-in defaults unless marked otherwise.

# ============================================================================
# 1. LLM backend: where chat completions go (shared by all agents + coordinator)
# ============================================================================

# Provider for chat completions: openai | gemini | litellm. Picks the default base_url (section 2). Default: litellm
LLM_BACKEND=litellm

# API key for the LLM_BACKEND above (OpenAI key, Google AI Studio key, or LiteLLM virtual/master key). Required. Default: empty
LLM_API_KEY=

# Model name as LLM_BACKEND knows it. Required. Default: empty
LLM_MODEL=

# Optional base_url override. Empty = default endpoint of LLM_BACKEND. Set for a LiteLLM that is not at the compose address (local: http://127.0.0.1:4000/v1). Default: empty
LLM_BASE_URL=

# ----------------------------------------------------------------------------
# 2. Default endpoint per LLM_BACKEND (only used when LLM_BASE_URL is empty)
# ----------------------------------------------------------------------------

# Endpoint used when LLM_BACKEND=openai. Default: https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Endpoint used when LLM_BACKEND=gemini (Gemini's OpenAI-compatible API, no Google SDK). Default: https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_OPENAI_COMPATIBLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Endpoint used when LLM_BACKEND=litellm; the compose service name of the LiteLLM container. Default: http://litellm:4000/v1
LITELLM_COMPOSE_BASE_URL=http://litellm:4000/v1

# ============================================================================
# 3. Service addresses (host-side values for local runs; compose overrides them)
# ============================================================================

# Our registry (registry_service). Agents POST /agents/register here, the coordinator GETs /agents. Only used when REGISTRY_MODE=own. Local run: http://127.0.0.1:8000. Default: http://registry:8000
REGISTRY_URL=http://registry:8000

# Where the terminal client (coordinator/main.py) reaches the GAIA API (coordinator/api.py). Same value works on host and inside the container. Default: http://127.0.0.1:8080
COORDINATOR_URL=http://127.0.0.1:8080

# Public URL of each sub-agent: goes on its agent card, into the registry, and its port is the bind port (must be explicit). Local run: http://127.0.0.1:800X. Defaults: compose service names
AETHER_AGENT_URL=http://aether-agent:8001
DEMETER_AGENT_URL=http://demeter-agent:8002
HEPHAESTUS_AGENT_URL=http://hephaestus-agent:8003

# ============================================================================
# 4. Agent discovery and call routing (own registry vs. LiteLLM proxy)
# ============================================================================

# Where the coordinator discovers agents: own (GET REGISTRY_URL/agents) | litellm (GET LITELLM_PROXY_URL/v1/agents). litellm needs LITELLM_PROXY_URL + LITELLM_PROXY_API_KEY. Default: own
REGISTRY_MODE=own

# How the coordinator calls an agent: direct (POST to the card URL) | litellm (relay via LITELLM_PROXY_URL/a2a/{id}). litellm needs LITELLM_PROXY_URL + LITELLM_PROXY_API_KEY. Can be mixed freely with REGISTRY_MODE. Default: direct
AGENT_CALL_MODE=direct

# LiteLLM proxy as infrastructure (registry / A2A relay). Only used when REGISTRY_MODE=litellm or AGENT_CALL_MODE=litellm. Independent of LLM_BACKEND. Local run: http://127.0.0.1:4000. Default: http://litellm:4000
LITELLM_PROXY_URL=http://litellm:4000

# Bearer token for LITELLM_PROXY_URL (virtual or master key). Required when REGISTRY_MODE=litellm or AGENT_CALL_MODE=litellm. Default: empty
LITELLM_PROXY_API_KEY=

# ============================================================================
# 5. docker compose only (read by docker-compose.yml, not by our code)
# ============================================================================

# External Docker network the LiteLLM container is on (`docker network ls`); the stack joins it to reach "litellm". Default: litellm-local_frontend
LITELLM_NETWORK=litellm-local_frontend

# Container-side LLM_BASE_URL injected into every service (e.g. https://api.openai.com/v1 with LLM_BACKEND=openai). Default: http://litellm:4000/v1
COMPOSE_LLM_BASE_URL=http://litellm:4000/v1

# Container-side LITELLM_PROXY_URL injected into every service. Default: http://litellm:4000
COMPOSE_LITELLM_PROXY_URL=http://litellm:4000

# Host port the registry is published on. The container always listens on 8000; change this only when something else on your machine already holds the port. Default: 8000
REGISTRY_HOST_PORT=8000

# ============================================================================
# 6. Self-hosted LiteLLM container only (litellm/config.yaml, os.environ/...)
#    Never read by our own code. Only needed if you start a LiteLLM container
#    from litellm/config.yaml.example; docker-compose.yml has no such service yet.
# ============================================================================

# Master key of that LiteLLM proxy; reuse it as LLM_API_KEY / LITELLM_PROXY_API_KEY. No default, LiteLLM refuses to start without it
# LITELLM_MASTER_KEY=sk-change-me

# Upstream OpenAI key for the model_name gpt-5 entry in litellm/config.yaml. Only needed if LLM_MODEL uses it. Default: empty
# OPENAI_API_KEY=

# Upstream Google AI Studio key for the model_name gemini-2.5-flash entry in litellm/config.yaml. Only needed if LLM_MODEL uses it. Default: empty
# GEMINI_API_KEY=
